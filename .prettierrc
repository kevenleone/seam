{
    "arrowParens": "always",
    "endOfLine": "lf",
    "jsonRecursiveSort": true,
    "overrides": [
        {
            "files": "*.json",
            "options": {
                "parser": "json"
            }
        },
        {
            "files": ["package.json", ".release-please-manifest.json"],
            "options": {
                "parser": "json-stringify"
            }
        }
    ],
    "plugins": ["prettier-plugin-sort-json", "prettier-plugin-tailwindcss"],
    "printWidth": 100,
    "semi": true,
    "singleQuote": true,
    "tabWidth": 4,
    "tailwindStylesheet": "./src/styles.css",
    "trailingComma": "all"
}
