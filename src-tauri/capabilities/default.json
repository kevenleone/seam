{
    "$schema": "../gen/schemas/desktop-schema.json",
    "description": "Every Seam window",
    "identifier": "default",
    "permissions": [
        "core:default",
        "core:window:allow-start-dragging",
        "core:window:allow-set-title",
        "core:window:allow-close",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "dialog:default",
        "opener:default",
        { "allow": [{ "path": "**" }], "identifier": "opener:allow-open-path" },
        { "allow": [{ "path": "**" }], "identifier": "opener:allow-reveal-item-in-dir" }
    ],
    "windows": ["*"]
}
