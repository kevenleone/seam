#!/bin/sh
# Runs the app's own binary in command-line mode; it reaches the app (or starts it)
# through `open`, the same way Finder does.

self="$0"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *) self="$(dirname "$self")/$target" ;;
    esac
done

# Seam.app/Contents/Resources/resources/seam
app="$(cd "$(dirname "$self")/../../.." && pwd)"
binary="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$app/Contents/Info.plist")"

exec "$app/Contents/MacOS/$binary" --cli "$@"
